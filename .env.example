# Supabase Direct Connection (Port 5432 required for DDL/Migrations)
DATABASE_URL=jdbc:postgresql://db.[YOUR_PROJECT_ID].supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_database_password

# Supabase API Keys
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_REGISTRATION_KEY=your_admin_registration_secret